<?xml version="1.0" encoding="utf-8"?>
<!--
  simse.vcxproj - profiling project.

  Compiles ONLY the amalgamated `simse_out.cpp` into `simse.exe` and links the
  RTL/native libraries from the matching CMake build folder, so the Visual
  Studio profiler (Debug > Performance Profiler, or Alt+F2) can be pointed at
  the compiler.

  - Release is the default configuration: /O2 with a full PDB (/Zi + /DEBUG),
    which is what the sampling/instrumentation profilers need.
  - Before compiling, `simse_out.cpp` is regenerated from `cppsrc` when any
    `.simse` source (or the transpiler itself) is newer than it. That step is
    skipped when the CMake folder has no `simse_transpile.exe`.
  - Output: `profile\<Configuration>\simse.exe` + `.pdb`.
-->
<Project DefaultTargets="Build" ToolsVersion="18.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6E6F2A44-2C9B-4E9D-9F3C-2B7A5D8E1C10}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>simse</RootNamespace>
    <ProjectName>simse</ProjectName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <!-- The CMake folder that holds simse_native.lib / simse_lib.lib. -->
    <SimseBuildDir Condition="'$(Configuration)'=='Release'">$(ProjectDir)cmake-build-release</SimseBuildDir>
    <SimseBuildDir Condition="'$(Configuration)'=='Debug'">$(ProjectDir)cmake-build-debug</SimseBuildDir>
    <OutDir>$(ProjectDir)profile\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)profile\obj\$(Configuration)\</IntDir>
    <TargetName>simse</TargetName>
    <LinkIncremental>false</LinkIncremental>
    <!-- Default argument for F5 / profiler runs: compile the whole tree. -->
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerWorkingDirectory>$(ProjectDir)</LocalDebuggerWorkingDirectory>
    <LocalDebuggerCommandArguments>--root cppsrc</LocalDebuggerCommandArguments>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <!-- /Zi in Release keeps symbols for the profiler. -->
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalDependencies>$(SimseBuildDir)\simse_native.lib;$(SimseBuildDir)\simse_lib.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>$(SimseBuildDir)\simse_native.lib;$(SimseBuildDir)\simse_lib.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="simse_out.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="cppsrc\rtl\simse.hpp" />
  </ItemGroup>
  <ItemGroup>
    <SimseSource Include="cppsrc\**\*.simse" />
  </ItemGroup>

  <!-- Regenerate simse_out.cpp only when a source (or the transpiler) is newer. -->
  <Target Name="RefreshSimseOut" BeforeTargets="ClCompile"
          Condition="Exists('$(SimseBuildDir)\simse_transpile.exe')"
          Inputs="@(SimseSource);$(SimseBuildDir)\simse_transpile.exe"
          Outputs="$(ProjectDir)simse_out.cpp">
    <Exec Command="&quot;$(SimseBuildDir)\simse_transpile.exe&quot; --root cppsrc -o simse_out.cpp"
          WorkingDirectory="$(ProjectDir)" />
    <Message Importance="high" Text="Refreshed simse_out.cpp from cppsrc" />
  </Target>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
