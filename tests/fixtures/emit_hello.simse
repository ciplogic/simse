data class Counter(var value: Int) {
    fun bump(): Int {
        return this.value + 1
    }
}

fun main(): Int {
    var i: Int = 0
    var total: Int = 0
    while (i < 5) {
        total = total + i
        i = i + 1
    }
    val c: Counter = Counter(10)
    if (total > 5) {
        println(total)
    } else {
        println(c.bump())
    }
    println(true)
    return 0
}
