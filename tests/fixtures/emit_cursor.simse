// T16: iteration with Cursor<T> instead of range-for.

fun sum(items: &List<Int>): Int {
    var total: Int = 0
    var c: Cursor<Int> = cursorOf(items)
    while (c.hasValue()) {
        total = total + c.value()
        c = c.next()
    }
    return total
}

fun headSum(items: &List<Int>): Int {
    val full: Cursor<Int> = cursorOf(items)
    var head: Cursor<Int> = full.slice(2)
    var total: Int = 0
    while (head.hasValue()) {
        total = total + head.value()
        head = head.next()
    }
    return total
}

fun main(): Int {
    var items: List<Int> = List<Int>()
    items.append(4)
    items.append(7)
    items.append(9)

    val view: &List<Int> = &items
    println(sum(view))

    val all: Cursor<Int> = cursorOf(view)
    println(all.size())

    println(headSum(view))
    return 0
}
