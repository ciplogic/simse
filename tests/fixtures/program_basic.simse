// Declarations, statements, and expressions.
enum Color {
    Red,
    Green = 4,
    Blue
}

data class Point(var x: Int; var y: Int) {
    fun sum(): Int {
        return this.x + this.y
    }
}

typealias IntPredicate = (Int) -> Bool

typealias FloatHandler = (*Float64) -> Unit

fun add(a: Int, b: Int): Int {
    return a + b
}
