fun useGenerics(): Res<Int> {
    val value: Int = 3
    val list: List<Int> = List<Int>()
    val opt: Opt<Int> = Opt<Int>()
    val okValue: Res<Int> = Res<Int>.ok(value)
    val errValue: Res<Int> = Res<Int>.err("nope")
    val reference = &value
    val dereferenced = *reference
    return Res<Int>.ok(value)
}
