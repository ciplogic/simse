// The argv form of `main`: the parameter is a `List<Str>` built from argv (the
// program name is excluded). Run with one argument, e.g. `alpha`.

fun main(args: List<Str>): Int {
    println(args.size())
    var i: Int = 0
    while (i < args.size()) {
        println(args[i])
        i = i + 1
    }
    return 0
}
