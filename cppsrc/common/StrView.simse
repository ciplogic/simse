// StrView.simse
//
// Shared helpers. StrView is a view over a range of a Str; it borrows the
// source through a counted reference so a view can outlive the expression that
// produced it without copying the text.

package common

data class StrView(var source: &Str; var start: Int; var len: Int) {
    fun at(index: Int): Char {
        return this.source[this.start + index]
    }

    fun startsWith(text: Str): Bool {
        if (text.size() > this.len) {
            return false
        }
        var i = 0
        while (i < text.size()) {
            if (this.at(i) != text[i]) {
                return false
            }
            i = i + 1
        }
        return true
    }

    fun slice(matchLength: Int): StrView {
        return StrView(this.source, this.start, matchLength)
    }

    fun toString(): Str {
        var result: Str = Str()
        var i = 0
        while (i < this.len) {
            result.append(this.at(i))
            i = i + 1
        }
        return result
    }
}
