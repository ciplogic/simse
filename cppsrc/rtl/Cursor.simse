// Cursor.simse
//
// The immutable, Span-like cursor over a List<T> (T16, specs/containers.md).
// Declarations only: the concrete type and its methods live in
// cppsrc/rtl/cursor.hpp, and codegen maps `Cursor<T>` onto the RTL type. Member
// calls (hasValue/value/next/slice/size) lower to the C++ member functions, so
// the bodies here are documentation, not emitted code.
//
// Iteration is `while (c.hasValue()) { ... c = c.next() }`. `for`/range-for
// remain deferred; the cursor is the replacement idiom.

data class Cursor<T>(var source: &List<T>; var start: Int; var len: Int) {
    // True while at least one element remains.
    fun hasValue(): Bool {
        return this.len > 0
    }

    // The first remaining element, by value.
    fun value(): T {
        return this.source[this.start]
    }

    // The cursor advanced by one element (a new cursor; this one is unchanged).
    fun next(): Cursor<T> {
        return this.slice(1)
    }

    // The cursor advanced by `count` elements (unchecked, like the RTL).
    fun slice(count: Int): Cursor<T> {
        return Cursor<T>(this.source, this.start + count, this.len - count)
    }

    // The number of remaining elements.
    fun size(): Int {
        return this.len
    }
}

// A cursor covering all of `items` from index 0. The body is the RTL helper
// `simse_cursorOf` in cppsrc/rtl/cursor.hpp.
native("simse_cursorOf") fun cursorOf<T>(items: &List<T>): Cursor<T>
