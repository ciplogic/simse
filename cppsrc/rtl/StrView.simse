// StrView.simse
//
// The borrowed view over a range of a `Str` (specs/built-in-types.md, "Views").
// Declarations only: the concrete type and its methods live in
// cppsrc/rtl/strview.hpp, and codegen maps member calls onto the RTL type, so the
// bodies here are documentation, not emitted code.
//
// A view copies nothing and owns nothing: it stays valid only while the source
// `Str` is alive and unchanged. `FileStream.readLineView()` hands back a window
// into the stream's readahead buffer, which the next read on that stream moves;
// a view over a local `Str` stays valid as long as that local is not resized.
//
// `slice` stays a view (the parsing idiom: split a buffer without allocating),
// `substr` and `toStr` are the owned copies.

package rtl

data class StrView(var source: *Str; var start: Int; var len: Int) {
    // The number of bytes in the view.
    fun size(): Int {
        return this.len
    }

    // True when the view covers no bytes.
    fun isEmpty(): Bool {
        return this.len <= 0
    }

    // The byte at `index` (unchecked).
    fun at(index: Int): Char {
        return this.source[this.start + index]
    }

    // The same byte, spelled like `Str.charAt` (unchecked).
    fun charAt(index: Int): Char {
        return this.at(index)
    }

    // True when the view begins with `text`.
    fun startsWith(text: Str): Bool {
        if (text.size() > this.len) {
            return false
        }
        var i = 0
        while (i < text.size()) {
            if (this.at(i) != text[i]) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // The index of the first occurrence of `sub` inside the view, or -1.
    fun find(sub: Str): Int {
        if (sub.size() > this.len) {
            return -1
        }
        var i = 0
        while (i + sub.size() <= this.len) {
            var j = 0
            var same = true
            while (j < sub.size()) {
                if (this.at(i + j) != sub[j]) {
                    same = false
                    break
                }
                j = j + 1
            }
            if (same) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    // `indexOf` is the other spelling of `find`.
    fun indexOf(sub: Str): Int {
        return this.find(sub)
    }

    // A view of `count` bytes starting `from` bytes into this view: no copy.
    fun slice(from: Int, count: Int): StrView {
        return StrView(this.source, this.start + from, count)
    }

    // The owned copy of `count` bytes starting `from` bytes in.
    fun substr(from: Int, count: Int): Str {
        return this.slice(from, count).toStr()
    }

    // The owned copy of the whole view.
    fun toStr(): Str {
        var result: Str = Str()
        var i = 0
        while (i < this.len) {
            result.append(this.at(i))
            i = i + 1
        }
        return result
    }
}
