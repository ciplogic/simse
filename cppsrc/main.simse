package cppsrc

import cppsrc.lex
import cppsrc.common

// Simse-side factory for a fresh Scanner. The data class has a single
// constructor taking every field; a scanner is created empty and then fed with
// `setSource`. This is the idiomatic construction the mirror exposes to users.
fun newScanner(rules: &List<TokenMatcher>): Scanner {
    return Scanner(rules, 0, 1, 1, "")
}

// Tokenizes this file and prints the number of non-space, non-comment tokens.
fun main(): Int {
    val scanner: Scanner = newScanner(getTokenRules())
    val content: Str = readFile("cppsrc/main.simse")
    scanner.setSource(content)

    var count: Int = 0
    while (true) {
        val result: Res<Token> = scanner.nextToken()
        if (!result.isOk()) {
            println(result.error)
            return 1
        }
        if (result.value.kind == TokenKind.Eof) {
            break
        }
        if (result.value.kind != TokenKind.Space && result.value.kind != TokenKind.Comment) {
            count = count + 1
        }
    }
    println(count)
    return 0
}
