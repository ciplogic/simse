// Sema.simse
//
// The name/type-resolution pass, ported from cppsrc/sema/Sema.cpp. It consumes the
// XmlNode AST (schema in impl_specs/ast-xmlnode.md) and returns the same
// diagnostics, in the same order, as the C++ `sema::analyze`.
//
// Positional information comes from the `line`/`column` attributes; the port
// mirrors the C++ traversal exactly (hoisting, scopes, conservative checks).
//
// Iteration uses `while` and List indexing (there is no range-for). Kind dispatch
// is an if-chain, not a `switch`, because the emitted C++ `switch` cannot switch
// on a `Str`.

import cppsrc.parser

// The read-only XmlNode accessors (xmlAttr, xmlChild, xmlChildren, ...) live in
// cppsrc/common/xmlutil.simse; they arrive through the parser's `import
// cppsrc.lex` -> `cppsrc.common`. Only the sema-specific logic stays here.

// A value binding in scope: mutability, whether assignment is checked, and the
// declared/inferred type (an empty XmlNode when unknown).
data class ValueBinding(var isMutable: Bool; var checkAssign: Bool; var type: XmlNode)

// ---- built-in type knowledge ----------------------------------------------

fun semaIsBuiltinType(name: Str): Bool {
    if (name == "Int" || name == "Int8" || name == "Int16" || name == "Int32"
        || name == "Int64" || name == "Float32" || name == "Float64" || name == "Char"
        || name == "Str" || name == "Bool" || name == "Unit" || name == "List"
        || name == "Array" || name == "RawArray" || name == "Opt" || name == "Res"
        || name == "Dictionary" || name == "SmallVector" || name == "PList") {
        return true
    }
    return false
}

// The number of type parameters a built-in generic expects, or -1 when the name
// is not a built-in generic.
fun semaBuiltinGenericArity(name: Str): Int {
    if (name == "List" || name == "Array" || name == "RawArray" || name == "Opt"
        || name == "Res" || name == "PList") {
        return 1
    }
    if (name == "Dictionary" || name == "SmallVector") {
        return 2
    }
    return -1
}

// ---- constant expressions -------------------------------------------------

fun semaIsConstantExpr(expr: XmlNode): Bool {
    val kind: Str = xmlKind(expr)
    if (kind == "Expr.IntLit" || kind == "Expr.FloatLit" || kind == "Expr.StrLit"
        || kind == "Expr.CharLit" || kind == "Expr.BoolLit" || kind == "Expr.Name"
        || kind == "Expr.Member") {
        return true
    }
    if (kind == "Expr.Unary") {
        val operand: XmlNode = xmlChild(expr, "Operand")
        if (!xmlIsEmpty(operand)) {
            return semaIsConstantExpr(operand)
        }
    }
    return false
}

// ---- receiver unification -------------------------------------------------

// Simple structural unification of an extension receiver pattern (which may
// mention the extension's type parameters) against the actual receiver type.
// References/pointers on the actual side are auto-dereferenced, matching the
// member-call decision.
fun semaUnifyReceiver(pattern: XmlNode, actual: XmlNode, typeParams: List<Str>): Bool {
    var actualPtr: XmlNode = actual
    val pk: Str = xmlKind(pattern)
    if (pk != "Type.Reference" && pk != "Type.Pointer") {
        while ((xmlKind(actualPtr) == "Type.Reference" || xmlKind(actualPtr) == "Type.Pointer")
               && !xmlIsEmpty(xmlChild(actualPtr, "Inner"))) {
            actualPtr = xmlChild(actualPtr, "Inner")
        }
    }
    val ak: Str = xmlKind(actualPtr)
    if (pk == "Type.IntLit") {
        return ak == "Type.IntLit" && xmlAttr(actualPtr, "text") == xmlAttr(pattern, "text")
    }
    if (pk == "Type.Named") {
        if (xmlIsTypeParam(xmlAttr(pattern, "name"), typeParams)) {
            return true
        }
        return ak == "Type.Named" && xmlAttr(actualPtr, "name") == xmlAttr(pattern, "name")
    }
    if (pk == "Type.Generic") {
        if (xmlIsTypeParam(xmlAttr(pattern, "name"), typeParams)) {
            return true
        }
        if (ak != "Type.Generic" || xmlAttr(actualPtr, "name") != xmlAttr(pattern, "name")) {
            return false
        }
        val patternArgs: List<XmlNode> = xmlChildren(pattern, "TypeArg")
        val actualArgs: List<XmlNode> = xmlChildren(actualPtr, "TypeArg")
        if (patternArgs.size() != actualArgs.size()) {
            return false
        }
        var i: Int = 0
        while (i < patternArgs.size()) {
            if (!semaUnifyReceiver(patternArgs[i], actualArgs[i], typeParams)) {
                return false
            }
            i = i + 1
        }
        return true
    }
    if (pk == "Type.Reference") {
        if (ak == "Type.Reference" && !xmlIsEmpty(xmlChild(actualPtr, "Inner"))
            && !xmlIsEmpty(xmlChild(pattern, "Inner"))) {
            return semaUnifyReceiver(xmlChild(pattern, "Inner"), xmlChild(actualPtr, "Inner"), typeParams)
        }
        return false
    }
    if (pk == "Type.Pointer") {
        if (ak == "Type.Pointer" && !xmlIsEmpty(xmlChild(actualPtr, "Inner"))
            && !xmlIsEmpty(xmlChild(pattern, "Inner"))) {
            return semaUnifyReceiver(xmlChild(pattern, "Inner"), xmlChild(actualPtr, "Inner"), typeParams)
        }
        return false
    }
    return false
}

// ---- the analyzer ---------------------------------------------------------

data class Analyzer(
    var module: XmlNode;
    var file: Str;
    var hasImports: Bool;
    var types: Dictionary<Str, XmlNode>;
    var functions: Dictionary<Str, List<XmlNode>>;
    var scopes: List<Dictionary<Str, ValueBinding>>;
    var typeScopes: List<List<Str>>;
    var loopDepth: Int;
    var breakDepth: Int;
    var diags: List<Str>
) {

    // ---- entry ------------------------------------------------------------

    fun run(): Unit {
        this.collect()
        val decls: List<XmlNode> = xmlDecls(this.module)
        var i: Int = 0
        while (i < decls.size()) {
            this.analyzeDecl(decls[i])
            i = i + 1
        }
    }

    fun diag(line: Int, column: Int, message: Str): Unit {
        this.diags.append(this.file + ":" + line.toString() + ":" + column.toString()
                         + ": " + message)
    }

    // ---- symbol collection ------------------------------------------------

    fun addFunction(name: Str, decl: XmlNode): Unit {
        if (this.functions.has(name)) {
            var existing: List<XmlNode> = this.functions.get(name).value()
            existing.append(decl)
            this.functions.insert(name, existing)
        } else {
            var fresh: List<XmlNode> = List<XmlNode>()
            fresh.append(decl)
            this.functions.insert(name, fresh)
        }
    }

    fun collect(): Unit {
        val decls: List<XmlNode> = xmlDecls(this.module)
        var i: Int = 0
        while (i < decls.size()) {
            val decl: XmlNode = decls[i]
            val name: Str = xmlAttr(decl, "name")
            val isFunction: Bool = xmlKind(decl) == "Function"
            val nameTaken: Bool = this.types.has(name) || this.functions.has(name)
            if (isFunction) {
                if (this.types.has(name)) {
                    this.diag(xmlLine(decl), xmlColumn(decl), "duplicate declaration '" + name + "'")
                } else {
                    this.addFunction(name, decl)
                }
            } else {
                if (nameTaken) {
                    this.diag(xmlLine(decl), xmlColumn(decl), "duplicate declaration '" + name + "'")
                } else {
                    this.types.insert(name, decl)
                }
            }
            i = i + 1
        }
    }

    // ---- scopes -----------------------------------------------------------

    fun pushScope(): Unit {
        this.scopes.append(Dictionary<Str, ValueBinding>())
    }

    fun popScope(): Unit {
        this.scopes.removeAt(this.scopes.size() - 1)
    }

    fun pushTypeScope(): Unit {
        this.typeScopes.append(List<Str>())
    }

    fun popTypeScope(): Unit {
        this.typeScopes.removeAt(this.typeScopes.size() - 1)
    }

    fun declareType(name: Str): Unit {
        if (this.typeScopes.size() == 0) {
            return
        }
        this.typeScopes[this.typeScopes.size() - 1].append(name)
    }

    fun declareValue(name: Str, isMutable: Bool, checkAssign: Bool, type: XmlNode): Unit {
        if (this.scopes.size() == 0) {
            return
        }
        this.scopes[this.scopes.size() - 1].insert(name, ValueBinding(isMutable, checkAssign, type))
    }

    fun lookupValue(name: Str): Opt<ValueBinding> {
        var i: Int = this.scopes.size() - 1
        while (i >= 0) {
            if (this.scopes[i].has(name)) {
                return this.scopes[i].get(name)
            }
            i = i - 1
        }
        return Opt<ValueBinding>.none()
    }

    fun typeParamVisible(name: Str): Bool {
        var i: Int = 0
        while (i < this.typeScopes.size()) {
            var j: Int = 0
            while (j < this.typeScopes[i].size()) {
                if (this.typeScopes[i][j] == name) {
                    return true
                }
                j = j + 1
            }
            i = i + 1
        }
        return false
    }

    // ---- type resolution --------------------------------------------------

    fun checkTypeName(name: Str, line: Int, column: Int): Unit {
        if (semaIsBuiltinType(name) || this.types.has(name) || this.typeParamVisible(name)) {
            return
        }
        // Import contents are not modeled, so a name that might come from an
        // import is not reported (imports are conservative by design).
        if (this.hasImports) {
            return
        }
        this.diag(line, column, "unknown type '" + name + "'")
    }

    fun checkInstantiationArity(name: Str, argCount: Int, line: Int, column: Int): Unit {
        var expected: Int = -1
        if (this.types.has(name)) {
            expected = xmlCount(this.types.get(name).value(), "TypeParam")
        } else {
            expected = semaBuiltinGenericArity(name)
        }
        if (expected >= 0 && argCount != expected) {
            this.diag(line, column, "'" + name + "' expects " + expected.toString()
                                   + " type argument(s) but got " + argCount.toString())
        }
    }

    fun resolveType(type: XmlNode): Unit {
        val kind: Str = xmlKind(type)
        if (kind == "Type.IntLit") {
            return
        }
        if (kind == "Type.Named") {
            this.checkTypeName(xmlAttr(type, "name"), xmlLine(type), xmlColumn(type))
            return
        }
        if (kind == "Type.Generic") {
            this.checkTypeName(xmlAttr(type, "name"), xmlLine(type), xmlColumn(type))
            this.checkInstantiationArity(xmlAttr(type, "name"), xmlCount(type, "TypeArg"),
                                         xmlLine(type), xmlColumn(type))
            val args: List<XmlNode> = xmlChildren(type, "TypeArg")
            var i: Int = 0
            while (i < args.size()) {
                this.resolveType(args[i])
                i = i + 1
            }
            return
        }
        if (kind == "Type.Reference" || kind == "Type.Pointer") {
            val inner: XmlNode = xmlChild(type, "Inner")
            if (!xmlIsEmpty(inner)) {
                this.resolveType(inner)
            }
            return
        }
        if (kind == "Type.Function") {
            val params: List<XmlNode> = xmlChildren(type, "ParamType")
            var i: Int = 0
            while (i < params.size()) {
                this.resolveType(params[i])
                i = i + 1
            }
            val ret: XmlNode = xmlChild(type, "ReturnType")
            if (!xmlIsEmpty(ret)) {
                this.resolveType(ret)
            }
            return
        }
    }

    // ---- declaration analysis ---------------------------------------------

    fun analyzeDecl(decl: XmlNode): Unit {
        val kind: Str = xmlKind(decl)
        if (kind == "DataClass") {
            this.pushTypeScope()
            val typeParams: List<Str> = xmlTypeParamNames(decl)
            var i: Int = 0
            while (i < typeParams.size()) {
                this.declareType(typeParams[i])
                i = i + 1
            }
            this.pushScope()
            this.declareValue("this", true, false, xmlEmptyNode())
            val fields: List<XmlNode> = xmlChildren(decl, "Field")
            var f: Int = 0
            while (f < fields.size()) {
                val fieldType: XmlNode = xmlChild(fields[f], "Type")
                if (!xmlIsEmpty(fieldType)) {
                    this.resolveType(fieldType)
                }
                f = f + 1
            }
            val methods: List<XmlNode> = xmlChildren(decl, "Function")
            var m: Int = 0
            while (m < methods.size()) {
                this.analyzeFunction(methods[m])
                m = m + 1
            }
            this.popScope()
            this.popTypeScope()
            return
        }
        if (kind == "Enum") {
            return
        }
        if (kind == "TypeAlias") {
            this.pushTypeScope()
            val typeParams: List<Str> = xmlTypeParamNames(decl)
            var i: Int = 0
            while (i < typeParams.size()) {
                this.declareType(typeParams[i])
                i = i + 1
            }
            val target: XmlNode = xmlChild(decl, "TargetType")
            if (!xmlIsEmpty(target)) {
                this.resolveType(target)
            }
            this.popTypeScope()
            return
        }
        if (kind == "Function") {
            this.analyzeFunction(decl)
            return
        }
    }

    fun analyzeFunction(decl: XmlNode): Unit {
        this.pushTypeScope()
        val typeParams: List<Str> = xmlTypeParamNames(decl)
        var i: Int = 0
        while (i < typeParams.size()) {
            this.declareType(typeParams[i])
            i = i + 1
        }
        this.pushScope()
        this.declareValue("this", true, false, xmlEmptyNode())
        if (xmlAttr(decl, "hasReceiver") == "true") {
            val receiver: XmlNode = xmlChild(decl, "Receiver")
            if (!xmlIsEmpty(receiver)) {
                this.resolveType(receiver)
            }
        }
        val params: List<XmlNode> = xmlChildren(decl, "Param")
        var p: Int = 0
        while (p < params.size()) {
            val paramType: XmlNode = xmlChild(params[p], "Type")
            if (!xmlIsEmpty(paramType)) {
                this.resolveType(paramType)
            }
            // Parameters are not `val` declarations, so reassigning one is never
            // reported (under-report rather than risk a false hit).
            this.declareValue(xmlAttr(params[p], "name"), true, false, paramType)
            p = p + 1
        }
        val returnType: XmlNode = xmlChild(decl, "ReturnType")
        if (!xmlIsEmpty(returnType)) {
            this.resolveType(returnType)
        }

        val savedLoopDepth: Int = this.loopDepth
        this.loopDepth = 0
        val body: List<XmlNode> = xmlChildren(xmlChild(decl, "Body"), "Stmt")
        var s: Int = 0
        while (s < body.size()) {
            this.analyzeStmt(body[s])
            s = s + 1
        }
        this.loopDepth = savedLoopDepth

        this.popScope()
        this.popTypeScope()
    }

    // ---- statement analysis -----------------------------------------------

    fun analyzeStmt(stmt: XmlNode): Unit {
        val kind: Str = xmlKind(stmt)
        if (kind == "Stmt.VarDecl") {
            val init: XmlNode = xmlChild(stmt, "Init")
            if (!xmlIsEmpty(init)) {
                this.analyzeExpr(init)
            }
            val declaredType: XmlNode = xmlChild(stmt, "Type")
            if (!xmlIsEmpty(declaredType)) {
                this.resolveType(declaredType)
            }
            var type: XmlNode = declaredType
            if (xmlIsEmpty(type) && !xmlIsEmpty(init)) {
                type = this.exprType(init)
            }
            this.declareValue(xmlAttr(stmt, "name"), xmlAttr(stmt, "isVar") == "true", true, type)
            return
        }
        if (kind == "Stmt.Assign") {
            val target: XmlNode = xmlChild(stmt, "Target")
            if (!xmlIsEmpty(target)) {
                this.analyzeExpr(target)
            }
            val value: XmlNode = xmlChild(stmt, "Value")
            if (!xmlIsEmpty(value)) {
                this.analyzeExpr(value)
            }
            if (!xmlIsEmpty(target) && xmlKind(target) == "Expr.Name") {
                val binding: Opt<ValueBinding> = this.lookupValue(xmlAttr(target, "name"))
                if (binding.hasValue() && binding.value().checkAssign && !binding.value().isMutable) {
                    this.diag(xmlLine(target), xmlColumn(target),
                              "cannot assign to val '" + xmlAttr(target, "name") + "'")
                }
            }
            return
        }
        if (kind == "Stmt.If") {
            val cond: XmlNode = xmlChild(stmt, "Cond")
            if (!xmlIsEmpty(cond)) {
                this.analyzeExpr(cond)
            }
            this.pushScope()
            val thenBody: List<XmlNode> = xmlChildren(xmlChild(stmt, "Then"), "Stmt")
            var t: Int = 0
            while (t < thenBody.size()) {
                this.analyzeStmt(thenBody[t])
                t = t + 1
            }
            this.popScope()
            val elseBlock: XmlNode = xmlChild(stmt, "Else")
            if (!xmlIsEmpty(elseBlock)) {
                this.pushScope()
                val elseBody: List<XmlNode> = xmlChildren(elseBlock, "Stmt")
                var e: Int = 0
                while (e < elseBody.size()) {
                    this.analyzeStmt(elseBody[e])
                    e = e + 1
                }
                this.popScope()
            }
            return
        }
        if (kind == "Stmt.While") {
            val cond: XmlNode = xmlChild(stmt, "Cond")
            if (!xmlIsEmpty(cond)) {
                this.analyzeExpr(cond)
            }
            this.pushScope()
            this.loopDepth = this.loopDepth + 1
            this.breakDepth = this.breakDepth + 1
            val body: List<XmlNode> = xmlChildren(xmlChild(stmt, "Body"), "Stmt")
            var b: Int = 0
            while (b < body.size()) {
                this.analyzeStmt(body[b])
                b = b + 1
            }
            this.breakDepth = this.breakDepth - 1
            this.loopDepth = this.loopDepth - 1
            this.popScope()
            return
        }
        if (kind == "Stmt.Switch") {
            val cond: XmlNode = xmlChild(stmt, "Cond")
            if (!xmlIsEmpty(cond)) {
                this.analyzeExpr(cond)
            }
            this.breakDepth = this.breakDepth + 1
            val cases: List<XmlNode> = xmlChildren(stmt, "Case")
            var c: Int = 0
            while (c < cases.size()) {
                val switchCase: XmlNode = cases[c]
                val label: XmlNode = xmlChild(switchCase, "Label")
                if (xmlAttr(switchCase, "isDefault") != "true" && !xmlIsEmpty(label)) {
                    this.analyzeExpr(label)
                    if (!semaIsConstantExpr(label)) {
                        this.diag(xmlLine(label), xmlColumn(label),
                                  "case label must be a constant expression")
                    }
                }
                this.pushScope()
                val arm: List<XmlNode> = xmlChildren(switchCase, "Stmt")
                var a: Int = 0
                while (a < arm.size()) {
                    this.analyzeStmt(arm[a])
                    a = a + 1
                }
                this.popScope()
                c = c + 1
            }
            this.breakDepth = this.breakDepth - 1
            return
        }
        if (kind == "Stmt.Return") {
            val value: XmlNode = xmlChild(stmt, "Value")
            if (!xmlIsEmpty(value)) {
                this.analyzeExpr(value)
            }
            return
        }
        if (kind == "Stmt.Break") {
            if (this.breakDepth == 0) {
                this.diag(xmlLine(stmt), xmlColumn(stmt), "'break' outside a loop or switch")
            }
            return
        }
        if (kind == "Stmt.Continue") {
            if (this.loopDepth == 0) {
                this.diag(xmlLine(stmt), xmlColumn(stmt), "'continue' outside a loop")
            }
            return
        }
        if (kind == "Stmt.ExprStmt") {
            val expr: XmlNode = xmlChild(stmt, "Expr")
            if (!xmlIsEmpty(expr)) {
                this.analyzeExpr(expr)
            }
            return
        }
    }

    // ---- expression analysis ----------------------------------------------

    fun analyzeExpr(expr: XmlNode): Unit {
        val kind: Str = xmlKind(expr)
        if (kind == "Expr.IntLit" || kind == "Expr.FloatLit" || kind == "Expr.StrLit"
            || kind == "Expr.CharLit" || kind == "Expr.BoolLit" || kind == "Expr.NullLit"
            || kind == "Expr.Name") {
            return
        }
        if (kind == "Expr.GenericName") {
            this.checkGenericNameArity(expr)
            val args: List<XmlNode> = xmlChildren(expr, "TypeArg")
            var i: Int = 0
            while (i < args.size()) {
                this.resolveType(args[i])
                i = i + 1
            }
            return
        }
        if (kind == "Expr.Member") {
            val receiver: XmlNode = xmlChild(expr, "Receiver")
            if (!xmlIsEmpty(receiver)) {
                this.analyzeExpr(receiver)
            }
            return
        }
        if (kind == "Expr.Call") {
            val callee: XmlNode = xmlChild(expr, "Callee")
            if (!xmlIsEmpty(callee)) {
                this.analyzeExpr(callee)
            }
            val args: List<XmlNode> = xmlChildren(expr, "Arg")
            var i: Int = 0
            while (i < args.size()) {
                this.analyzeExpr(args[i])
                i = i + 1
            }
            this.checkCallArity(expr)
            this.checkExtensionCallArity(expr)
            return
        }
        if (kind == "Expr.Index") {
            val receiver: XmlNode = xmlChild(expr, "Receiver")
            if (!xmlIsEmpty(receiver)) {
                this.analyzeExpr(receiver)
            }
            val index: XmlNode = xmlChild(expr, "Index")
            if (!xmlIsEmpty(index)) {
                this.analyzeExpr(index)
            }
            return
        }
        if (kind == "Expr.Unary" || kind == "Expr.Ref" || kind == "Expr.Deref"
            || kind == "Expr.Copy") {
            val operand: XmlNode = xmlChild(expr, "Operand")
            if (!xmlIsEmpty(operand)) {
                this.analyzeExpr(operand)
            }
            return
        }
        if (kind == "Expr.Binary") {
            val lhs: XmlNode = xmlChild(expr, "Lhs")
            if (!xmlIsEmpty(lhs)) {
                this.analyzeExpr(lhs)
            }
            val rhs: XmlNode = xmlChild(expr, "Rhs")
            if (!xmlIsEmpty(rhs)) {
                this.analyzeExpr(rhs)
            }
            return
        }
        if (kind == "Expr.Lambda") {
            this.pushScope()
            val names: List<Str> = xmlLambdaParams(expr)
            val paramTypes: List<XmlNode> = xmlChildren(expr, "ParamType")
            var i: Int = 0
            while (i < names.size()) {
                var type: XmlNode = xmlEmptyNode()
                if (paramTypes.size() == names.size()) {
                    type = paramTypes[i]
                }
                if (!xmlIsEmpty(type)) {
                    this.resolveType(type)
                }
                this.declareValue(names[i], true, false, type)
                i = i + 1
            }
            if (paramTypes.size() != names.size()) {
                var k: Int = 0
                while (k < paramTypes.size()) {
                    this.resolveType(paramTypes[k])
                    k = k + 1
                }
            }
            val savedLoopDepth: Int = this.loopDepth
            this.loopDepth = 0
            val body: List<XmlNode> = xmlChildren(xmlChild(expr, "Body"), "Stmt")
            var s: Int = 0
            while (s < body.size()) {
                this.analyzeStmt(body[s])
                s = s + 1
            }
            this.loopDepth = savedLoopDepth
            this.popScope()
            return
        }
    }

    fun checkGenericNameArity(expr: XmlNode): Unit {
        val argCount: Int = xmlCount(expr, "TypeArg")
        val name: Str = xmlAttr(expr, "name")
        if (this.functions.has(name)) {
            val overloads: List<XmlNode> = this.functions.get(name).value()
            var i: Int = 0
            while (i < overloads.size()) {
                if (xmlCount(overloads[i], "TypeParam") == argCount) {
                    return
                }
                i = i + 1
            }
            this.diag(xmlLine(expr), xmlColumn(expr), "no overload of '" + name + "' takes "
                      + argCount.toString() + " type argument(s)")
            return
        }
        this.checkInstantiationArity(name, argCount, xmlLine(expr), xmlColumn(expr))
    }

    fun checkCallArity(call: XmlNode): Unit {
        val callee: XmlNode = xmlChild(call, "Callee")
        if (xmlIsEmpty(callee)) {
            return
        }
        val kind: Str = xmlKind(callee)
        val generic: Bool = kind == "Expr.GenericName"
        if (kind != "Expr.Name" && !generic) {
            return
        }
        val name: Str = xmlAttr(callee, "name")
        if (this.lookupValue(name).hasValue()) {
            return // shadowed by a local/param
        }
        val argCount: Int = xmlCount(call, "Arg")

        // A call to a known data class is a constructor call: the argument count
        // must match the declared field count exactly.
        if (this.types.has(name)) {
            val decl: XmlNode = this.types.get(name).value()
            if (xmlKind(decl) == "DataClass") {
                val fieldCount: Int = xmlCount(decl, "Field")
                if (fieldCount != argCount) {
                    this.diag(xmlLine(call), xmlColumn(call), "data class '" + name
                              + "' expects " + fieldCount.toString() + " field(s) but got "
                              + argCount.toString())
                }
                return
            }
        }

        if (!this.functions.has(name)) {
            return
        }
        var typeArgCount: Int = 0
        if (generic) {
            typeArgCount = xmlCount(callee, "TypeArg")
        }
        val overloads: List<XmlNode> = this.functions.get(name).value()
        var i: Int = 0
        while (i < overloads.size()) {
            if (xmlCount(overloads[i], "Param") == argCount) {
                if (!generic || xmlCount(overloads[i], "TypeParam") == typeArgCount) {
                    return
                }
            }
            i = i + 1
        }
        this.diag(xmlLine(call), xmlColumn(call), "no overload of '" + name + "' takes "
                  + argCount.toString() + " argument(s)")
    }

    // The receiver's type, when the checker tracks it (a local/parameter name or
    // a generic construction). Empty when unknown.
    fun exprType(expr: XmlNode): XmlNode {
        if (xmlKind(expr) == "Expr.Name") {
            val binding: Opt<ValueBinding> = this.lookupValue(xmlAttr(expr, "name"))
            if (binding.hasValue()) {
                return binding.value().type
            }
            return xmlEmptyNode()
        }
        if (xmlKind(expr) == "Expr.Call") {
            val callee: XmlNode = xmlChild(expr, "Callee")
            if (xmlKind(callee) == "Expr.GenericName") {
                var built: XmlNode = XmlNode("Type", List<Attribute>(), &List<XmlNode>())
                built.attributes.append(Attribute("kind", "Type.Generic"))
                built.attributes.append(Attribute("name", xmlAttr(callee, "name")))
                val args: List<XmlNode> = xmlChildren(callee, "TypeArg")
                var i: Int = 0
                while (i < args.size()) {
                    built.Children.append(args[i])
                    i = i + 1
                }
                return built
            }
        }
        return xmlEmptyNode()
    }

    // Reports an arity mismatch only when a receiver-compatible extension method
    // exists but no overload takes the given value-argument count. Unknown
    // receiver types stay silent (conservative).
    fun checkExtensionCallArity(call: XmlNode): Unit {
        val callee: XmlNode = xmlChild(call, "Callee")
        if (xmlKind(callee) != "Expr.Member") {
            return
        }
        val name: Str = xmlAttr(callee, "name")
        if (!this.functions.has(name)) {
            return
        }
        val actual: XmlNode = this.exprType(xmlChild(callee, "Receiver"))
        if (xmlIsEmpty(actual)) {
            return
        }
        val argCount: Int = xmlCount(call, "Arg")
        var compatible: Bool = false
        val overloads: List<XmlNode> = this.functions.get(name).value()
        var i: Int = 0
        while (i < overloads.size()) {
            val fn: XmlNode = overloads[i]
            var receiver: XmlNode = xmlEmptyNode()
            var valueParamCount: Int = 0
            var hasRecv: Bool = false
            val params: List<XmlNode> = xmlChildren(fn, "Param")
            if (xmlAttr(fn, "hasReceiver") == "true" && !xmlIsEmpty(xmlChild(fn, "Receiver"))) {
                receiver = xmlChild(fn, "Receiver")
                valueParamCount = params.size()
                hasRecv = true
            } else if (params.size() > 0) {
                val first: XmlNode = params[0]
                if (xmlAttr(first, "name") == "this" && !xmlIsEmpty(xmlChild(first, "Type"))) {
                    receiver = xmlChild(first, "Type")
                    valueParamCount = params.size() - 1
                    hasRecv = true
                }
            }
            if (hasRecv) {
                if (semaUnifyReceiver(receiver, actual, xmlTypeParamNames(fn))) {
                    compatible = true
                    if (valueParamCount == argCount) {
                        return
                    }
                }
            }
            i = i + 1
        }
        if (compatible) {
            this.diag(xmlLine(call), xmlColumn(call), "no overload of '" + name + "' takes "
                      + argCount.toString() + " argument(s)")
        }
    }
}

// ---- entry point ----------------------------------------------------------

fun newAnalyzer(module: XmlNode, fileName: Str): Analyzer {
    return Analyzer(
        module,
        fileName,
        xmlHasImports(module),
        Dictionary<Str, XmlNode>(),
        Dictionary<Str, List<XmlNode>>(),
        List<Dictionary<Str, ValueBinding>>(),
        List<List<Str>>(),
        0,
        0,
        List<Str>()
    )
}

// Returns diagnostics of the form "<fileName>:<line>:<col>: <message>". An empty
// list means the module is clean.
fun analyze(module: XmlNode, fileName: Str): List<Str> {
    var analyzer: Analyzer = newAnalyzer(module, fileName)
    analyzer.run()
    return analyzer.diags
}
